# Database Configuration
# Update these values with your actual database settings
DB_HOST=host.docker.internal\SQLEXPRESS
DB_PORT=1433
DB_NAME=SAM
DB_USER=sa
DB_PASSWORD=YourPasswordHere
DB_TRUST_SERVER_CERTIFICATE=true

# Service Configuration
LOG_LEVEL=info

# Container timezone — must match the SCADA box's local timezone, because
# PLC writes Circlip_Time / Ring_Time as wall-clock strings (no timezone
# info) and the image matcher compares file mtimes against those strings
# using local-time components. Examples: Asia/Kolkata, America/Chicago,
# Europe/Berlin. Default is UTC.
TZ=Asia/Kolkata

# Image integration (CV-X cameras)
INCOMING_IMAGES_PATH=/data/incoming
IMAGES_OUTPUT_PATH=/data/images
DMC_STATIC_PREFIX=[)>.06-VTH16-P234102
CAM_CIRCLIP=CAM2
CAM_RING=CAM1
EXPECTED_RING_PICTURES_PER_ATTEMPT=25
EXPECTED_CIRCLIP_PICTURES_PER_ATTEMPT=1
IMAGE_RETENTION_DAYS=365
IMAGE_MATCH_TOLERANCE_SECONDS=300
# Forward-slack: max seconds an image's mtime is allowed to be EARLIER
# than the SAM_Log Ring_Time (image written before PLC log). Keep small
# so consecutive re-inspection attempts don't bleed into each other's
# window. Tolerance applies after Ring_Time; pre-tolerance applies before.
IMAGE_MATCH_PRE_TOLERANCE_SECONDS=60
IMAGE_PENDING_TIMEOUT_MINUTES=15
IMAGE_FILE_HANDLING=move
# Set to false if your watcher reliably receives inotify events. Polling is
# the safe default for Linux containers reading Windows bind-mounts.
IMAGE_WATCH_USE_POLLING=true
